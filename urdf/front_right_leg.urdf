<?xml version="1.0" ?>
<robot name = "quadruped_front_right_leg">

  <link name = "world"/>

  <joint name = "body_joint" type = "fixed">
    <parent link = "world"/>
    <child link = "body"/>
    <origin xyz = "0 0 0.5" rpy = "0 0 0"/>
  </joint>

  <link name = "body">
    <visual>
      <origin xyz = "0 0 0" rpy = "0 0 0"/>
      <geometry><box size = "0.3868 0.0930 0.04"/></geometry>
      <material name = "blue"><color rgba = "0 0 0.8 1"/></material>
    </visual>
    <inertial>
      <mass value = "10"/>
      <inertia ixx = "0.0085" ixy = "0" ixz = "0" iyy = "0.1260" iyz = "0" izz = "0.1319"/>
      <origin xyz = "0 0 0" rpy = "0 0 0"/>
    </inertial>
    <collision>
      <origin xyz = "0 0 0" rpy = "0 0 0"/>
      <geometry><box size = "0.3868 0.0930 0.04"/></geometry>
    </collision>
  </link>

  <joint name = "FR_hip_joint" type = "revolute">
    <parent link = "body"/>
    <child link = "FR_hip"/>
    <origin xyz = "0.1934 -0.0465 0" rpy = "0 0 0"/>
    <axis xyz = "1 0 0"/>
    <limit lower="-3.141" upper="3.141" effort="20" velocity="5"/>
  </joint>

  <link name = "FR_hip">
    <visual>
      <origin xyz = "0 -0.04775 0" rpy = "-1.5708 0 0"/>
      <geometry><cylinder length = "0.0955" radius = "0.02"/></geometry>
      <material name = "red"><color rgba = "0.8 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value = "0.25"/>
      <inertia ixx = "0.000215" ixy = "0" ixz = "0" iyy = "0.00005" iyz = "0" izz = "0.000215"/>
      <origin xyz = "0 -0.04775 0" rpy = "0 0 0"/>
    </inertial>
    <collision>
      <origin xyz = "0 -0.04775 0" rpy = "-1.5708 0 0"/>
      <geometry><cylinder length = "0.0955" radius = "0.02"/></geometry>
    </collision>
  </link>

  <joint name = "FR_thigh_joint" type = "revolute">
    <parent link = "FR_hip"/>
    <child link = "FR_thigh"/>
    <origin xyz = "0 -0.0955 0" rpy = "0 0 0"/>
    <axis xyz = "0 1 0"/>
    <limit lower="-3.141" upper="3.141" effort="20" velocity="5"/>
  </joint>

  <link name = "FR_thigh">
    <visual>
      <origin xyz = "0 0 -0.1065" rpy = "0 0 0"/>
      <geometry><cylinder length = "0.213" radius = "0.02"/></geometry>
      <material name = "red"><color rgba = "0.8 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value = "0.5"/>
      <inertia ixx = "0.00194" ixy = "0" ixz = "0" iyy = "0.00194" iyz = "0" izz = "0.0001"/>
      <origin xyz = "0 0 -0.1065" rpy = "0 0 0"/>
    </inertial>
    <collision>
      <origin xyz = "0 0 -0.1065" rpy = "0 0 0"/>
      <geometry><cylinder length = "0.213" radius = "0.02"/></geometry>
    </collision>
  </link>

  <joint name = "FR_calf_joint" type = "revolute">
    <parent link = "FR_thigh"/>
    <child link = "FR_calf"/>
    <origin xyz = "0 0 -0.213" rpy = "0 0 0"/>
    <axis xyz = "0 1 0"/>
    <limit lower="-3.141" upper="3.141" effort="20" velocity="5"/>
  </joint>

  <link name = "FR_calf">
    <visual>
      <origin xyz = "0 0 -0.1065" rpy = "0 0 0"/>
      <geometry><cylinder length = "0.213" radius = "0.02"/></geometry>
      <material name = "red"><color rgba = "0.8 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value = "0.5"/>
      <inertia ixx = "0.00194" ixy = "0" ixz = "0" iyy = "0.00194" iyz = "0" izz = "0.0001"/>
      <origin xyz = "0 0 -0.1065" rpy = "0 0 0"/>
    </inertial>
    <collision>
      <origin xyz = "0 0 -0.1065" rpy = "0 0 0"/>
      <geometry><cylinder length = "0.213" radius = "0.02"/></geometry>
    </collision>
  </link>

  <joint name="FR_foot_joint" type="fixed">
    <parent link="FR_calf"/>
    <child link="FR_foot"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
  </joint>

  <link name="FR_foot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
    <inertial>
      <mass value = "0.1"/>
      <inertia ixx = "0.000016" ixy = "0" ixz = "0" iyy = "0.000016" iyz = "0" izz = "0.000016"/>
      <origin xyz = "0 0 0" rpy = "0 0 0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
  </link>

  <transmission name="FR_hip_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="FR_hip_joint"><hardwareInterface>EffortJointInterface</hardwareInterface></joint>
    <actuator name="FR_hip_motor"><hardwareInterface>EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="FR_thigh_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="FR_thigh_joint"><hardwareInterface>EffortJointInterface</hardwareInterface></joint>
    <actuator name="FR_thigh_motor"><hardwareInterface>EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="FR_calf_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="FR_calf_joint"><hardwareInterface>EffortJointInterface</hardwareInterface></joint>
    <actuator name="FR_calf_motor"><hardwareInterface>EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>

</robot>